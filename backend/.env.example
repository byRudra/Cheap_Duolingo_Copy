# Copy to backend/.env and adjust. Every value is optional; defaults shown.
# Read by app/config.py (Settings). Tests ignore this file (tests/conftest.py pins values).

# SQLite file (relative paths resolve from backend/)
DATABASE_URL=sqlite:///./app.db
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seed the DB automatically on startup when it is empty (handy for ephemeral hosts)
AUTO_SEED=true
# Username of the seeded learner every request acts as (deps.get_current_user)
DEMO_USERNAME=arnav

# Game rules
MAX_HEARTS=5
# Minutes per regenerated heart; set to 1 for demos
HEART_REGEN_MINUTES=30
HEART_REFILL_GEM_COST=350
BASE_LESSON_XP=10
PERFECT_BONUS_XP=5
# XP for replaying a completed lesson; 0 disables it
PRACTICE_XP=5
DEFAULT_DAILY_GOAL_XP=20
# Defines "today" for streaks and the daily goal
APP_TIMEZONE=Asia/Kolkata

# Not read from this file: scripts/smoke_test.py reads API_URL from the shell
# environment (default http://localhost:8000).
